37.00 52.00 m 558.28 52.00 l 559.94 52.00 561.28 53.34 561.28 55.00 c 561.28 189.00 l 561.28 190.66 559.94 192.00 558.28 192.00 c 37.00 192.00 l 35.34 192.00 34.00 190.66 34.00 189.00 c 34.00 55.00 l 34.00 53.34 35.34 52.00 37.00 52.00 c B
